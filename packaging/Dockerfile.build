# Build environment for packaging/build_debs.sh on another ROS distro / Ubuntu release.
# Used by packaging/build_debs_docker.sh; build context is the repository root.
ARG ROS_DISTRO=jazzy
FROM ros:${ROS_DISTRO}-ros-base

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		python3-bloom python3-rosdep python3-catkin-pkg fakeroot debhelper dh-python curl \
	&& rm -rf /var/lib/apt/lists/*

# the packages' build and run dependencies, so CMake finds them during the build
COPY vizanti/package.xml /deps/vizanti/package.xml
COPY vizanti_msgs/package.xml /deps/vizanti_msgs/package.xml
COPY vizanti_server/package.xml /deps/vizanti_server/package.xml
COPY vizanti_cpp/package.xml /deps/vizanti_cpp/package.xml
COPY vizanti_demos/package.xml /deps/vizanti_demos/package.xml
RUN apt-get update \
	&& (rosdep update --rosdistro "$ROS_DISTRO" || rosdep update) \
	&& rosdep install --from-paths /deps --ignore-src --rosdistro "$ROS_DISTRO" -y \
	&& rm -rf /var/lib/apt/lists/*

# build_debs.sh checks apt for ROS packages rosdep has no rule for
RUN apt-get update
